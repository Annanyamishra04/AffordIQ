# Copy this file to .env (or set the variable in your hosting provider's
# dashboard) when deploying the frontend separately from the backend.
#
# Local development: leave this unset. Vite's dev server proxies /api to
# http://127.0.0.1:5001 (see vite.config.js), so the app works with the
# backend running locally on its default port.
#
# Production: set this to your deployed backend's full API URL, including
# the /api suffix, e.g.:
#   VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=
